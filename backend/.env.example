# Vorlage für backend/.env – kopieren und eigene Werte eintragen.
# Die echte .env wird nie committet.

# Geheimer Schlüssel für Django. Eigenen, langen Zufallswert eintragen.
DJANGO_SECRET_KEY=

# Entwicklungsmodus: True nur lokal, in Produktion False.
DJANGO_DEBUG=False

# Erlaubte Hostnamen, kommagetrennt.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL-Verbindung: postgres://BENUTZER:PASSWORT@HOST:PORT/DATENBANK
DATABASE_URL=

# Nur im Betrieb (Render), lokal leer lassen. Siehe docs/DEPLOYMENT.md.
# Adressen des Frontends für CORS, kommagetrennt, ohne / am Ende.
DJANGO_CORS_ORIGINS=
# HTTPS erzwingen und Cookies absichern (nur hinter einem HTTPS-Proxy).
DJANGO_HTTPS_ERZWINGEN=False
# Eigener Zugang, wird beim Start angelegt, wenn noch kein Nutzer existiert.
LERNTOOL_BENUTZER=
LERNTOOL_PASSWORT=

# Erster Tag des Wochenplans im Format JJJJ-MM-TT (optional, Standard: 2026-11-16)
LERNTOOL_LERNSTART=
